# --- Attribution (required) ---
# Free to use, fork and rebrand. The one condition is that credit to the original
# author stays visible. The server will not start until you acknowledge this.
# Nothing is sent anywhere; the value is compared locally.
ATTRIBUTION_ACK="https://github.com/ys941"

# Copy this file to `.env` and fill in real values there (.env is git-ignored).
# These can also be set from the dashboard Settings panel.
# If set here, they WIN over whatever is stored in Settings.

# Groq accepts MULTIPLE keys, comma-separated. They are rotated automatically
# when one hits its rate limit, so you get more daily headroom.
#   GROQ_API_KEY=gsk_key_one,gsk_key_two
GROQ_API_KEY=
GEMINI_API_KEY=

# Port the dashboard + bot run on
PORT=4499

# Access key required to open the dashboard.
# If set here it OVERRIDES the one in Settings and can't be changed from the UI.
# Leave blank to use the default (wa-admin-2025), changeable in Settings.
ACCESS_KEY=

# --- Deploy / persistence (used on Railway, Render, a VPS, etc.) ---
# Where the JSON store lives. Point this at a mounted volume so data survives redeploys.
DATA_DIR=/data
# Where the WhatsApp Web session is kept — keep it on the volume to avoid re-scanning the QR.
WWEBJS_DIR=/data/.wwebjs_auth
